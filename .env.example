# =============================================================================
# ReliaPay / ModuleDev course-1 — шаблон переменных
# Скопируйте в .env и подставьте локальные значения.
# Реальные секреты в Git не коммитятся.
# Автопроверка подменяет COURSE_JWT_SIGNING_KEY через Compose override.
# =============================================================================

# --- JWT (читает сервис api) ---
COURSE_JWT_ISSUER=moduledev-course
COURSE_JWT_AUDIENCE=moduledev-api
# HS256-ключ, не короче 32 байт. Не коммитить реальное значение.
COURSE_JWT_SIGNING_KEY=replace-with-at-least-32-byte-hs256-key

# --- PostgreSQL bootstrap (сервис postgres) ---
POSTGRES_DB=course
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password

# --- Роли приложения (не superuser) ---
COURSE_PUBLICATION_USER=course_publication
COURSE_PUBLICATION_PASSWORD=replace-with-local-publication-password
COURSE_RUNTIME_USER=course_runtime
COURSE_RUNTIME_PASSWORD=replace-with-local-runtime-password
# Роль workflow_worker (неделя 2). Если переменная не задана, Compose берёт default.
COURSE_WORKER_PASSWORD=replace-with-local-worker-password

# --- Подключение из api / cli внутри Compose ---
COURSE_DB_HOST=postgres
COURSE_DB_PORT=5432
COURSE_DB_NAME=course

# --- Наблюдаемость ---
OTEL_SERVICE_NAME=reliapay
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=Information
ASPNETCORE_ENVIRONMENT=Development
