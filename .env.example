# =============================================================================
# ReliaPay / ModuleDev course-1 — шаблон переменных
# Скопируйте в .env и подставьте локальные значения.
# Реальные секреты в Git не коммитятся.
# Public checker подменяет JWT, HMAC и capability через isolated environment.
# =============================================================================

# --- JWT (читает сервис api; в Compose нет default) ---
COURSE_JWT_ISSUER=moduledev-course
COURSE_JWT_AUDIENCE=moduledev-api
# HS256-ключ, не короче 32 байт. Не коммитить реальное значение.
COURSE_JWT_SIGNING_KEY=replace-with-at-least-32-byte-hs256-key

# --- Host port gateway ---
COURSE_GATEWAY_PORT=8080
COURSE_TEST_PROFILE=1

# --- PostgreSQL bootstrap (сервис postgres) ---
POSTGRES_DB=course
POSTGRES_USER=postgres
COURSE_POSTGRES_PASSWORD=replace-with-local-postgres-password
COURSE_MIGRATOR_PASSWORD=replace-with-local-migrator-password
COURSE_PUBLISHER_PASSWORD=replace-with-local-publisher-password
COURSE_RUNTIME_PASSWORD=replace-with-local-runtime-password
COURSE_WORKER_PASSWORD=replace-with-local-worker-password
COURSE_OUTBOX_PASSWORD=replace-with-local-outbox-password
COURSE_INBOX_PASSWORD=replace-with-local-inbox-password
COURSE_AUTOCHECK_PASSWORD=replace-with-local-autocheck-password

# --- Подключение из api / cli внутри Compose ---
COURSE_DB_HOST=postgres
COURSE_DB_PORT=5432
COURSE_DB_NAME=course
COURSE_PUBLICATION_USER=course_publication
COURSE_RUNTIME_USER=course_runtime
COURSE_WORKER_USER=workflow_worker

# --- Python-периметр / provider (HMAC и callback без default в Compose) ---
PROVIDER_URL=http://provider-simulator:8081
OUTBOX_OWNER=outbox-dispatcher
OUTBOX_OWNER_B=outbox-dispatcher-b
PROVIDER_CALLBACK_CAPABILITY=replace-with-local-callback-capability
# JWT HS256 (COURSE_JWT_*), scope receipt:write — не opaque-строка
PROVIDER_CALLBACK_TOKEN=replace-with-local-callback-jwt
PROVIDER_HMAC_SECRET=replace-with-local-hmac-secret-at-least-32b
RECEIPT_API_URL=http://gateway:8080/api/receipt/accept

# --- Наблюдаемость ---
OTEL_SERVICE_NAME=reliapay
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=Information
ASPNETCORE_ENVIRONMENT=Development

# --- Reliability / test-profile intervals (defaults for local contour) ---
COURSE_FAILPOINT=
COURSE_PROVIDER_TIMEOUT_MS=500
# Ceiling includes the first send; reclaim at max marks DEAD without a new provider HTTP.
COURSE_OUTBOX_MAX_ATTEMPTS=4
COURSE_OUTBOX_BACKOFF_BASE_MS=200
COURSE_OUTBOX_BACKOFF_MAX_MS=800
COURSE_OUTBOX_JITTER_MAX_MS=100
COURSE_OUTBOX_LEASE_MS=2000
COURSE_OUTBOX_POLL_MS=100
COURSE_INBOX_POLL_MS=500
COURSE_JOB_LEASE_MS=2000
COURSE_WORKER_POLL_MS=100
