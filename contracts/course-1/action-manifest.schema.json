{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliapay.local/contracts/course-1/action-manifest.schema.json",
  "title": "ActionManifest",
  "type": "object",
  "required": [
    "contract_version",
    "module",
    "action",
    "version",
    "http_method",
    "target_schema",
    "target_function",
    "request_schema",
    "response_schema",
    "outcomes",
    "required_policy",
    "idempotency_mode",
    "idempotency_scope",
    "timeout_ms",
    "enabled",
    "is_default"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "course-1"
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "http_method": {
      "type": "string",
      "const": "POST"
    },
    "target_schema": {
      "type": "string",
      "minLength": 1
    },
    "target_function": {
      "type": "string",
      "minLength": 1
    },
    "request_schema": {
      "anyOf": [
        { "type": "object" },
        { "type": "boolean" }
      ]
    },
    "response_schema": {
      "anyOf": [
        { "type": "object" },
        { "type": "boolean" }
      ]
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "required_policy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "idempotency_mode": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_scope": {
      "type": "string",
      "minLength": 1
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "is_default": {
      "type": "boolean"
    }
  }
}
