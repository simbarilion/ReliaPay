{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliapay.local/contracts/course-1/operation.result.schema.json",
  "title": "OperationResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "requestId",
    "operationKind",
    "amount",
    "currency",
    "status"
  ],
  "properties": {
    "operationId": { "type": "string", "format": "uuid" },
    "requestId": { "type": "string", "minLength": 1 },
    "operationKind": {
      "type": "string",
      "enum": ["PAYMENT_EXECUTION", "PAYMENT_APPROVAL"]
    },
    "amount": {
      "type": "string",
      "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9]?)|[1-9][0-9]{0,15}(?:\\.[0-9]{1,2})?)$"
    },
    "currency": { "type": "string", "const": "RUB" },
    "status": {
      "type": "string",
      "enum": ["CREATED", "PROCESSING", "COMPLETED", "REJECTED"]
    }
  }
}
