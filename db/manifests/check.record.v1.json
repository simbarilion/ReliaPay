{
  "contract_version": "course-1",
  "module": "check",
  "action": "record",
  "version": 1,
  "http_method": "POST",
  "target_schema": "app",
  "target_function": "runtime_record",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["token"],
    "properties": {
      "token": { "type": "string", "minLength": 1 }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["token", "seq"],
    "properties": {
      "token": { "type": "string" },
      "seq": { "type": "integer" }
    }
  },
  "outcomes": ["RECORDED"],
  "required_policy": ["payment:read"],
  "idempotency_mode": "required",
  "idempotency_scope": "principal_action",
  "timeout_ms": 2000,
  "enabled": false,
  "is_default": false
}
