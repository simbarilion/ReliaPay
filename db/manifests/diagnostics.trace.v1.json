{
  "contract_version": "course-1",
  "module": "diagnostics",
  "action": "trace",
  "version": 1,
  "http_method": "POST",
  "target_schema": "app",
  "target_function": "diagnostics_trace",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["identifier"],
    "properties": {
      "identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\r\\n]+$"
      }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": true
  },
  "outcomes": ["FOUND"],
  "required_policy": ["diagnostics:read"],
  "idempotency_mode": "none",
  "idempotency_scope": "none",
  "timeout_ms": 10000,
  "enabled": false,
  "is_default": false
}
