{
  "contract_version": "course-1",
  "module": "payment",
  "action": "apply_receipt",
  "version": 1,
  "http_method": "POST",
  "target_schema": "app",
  "target_function": "payment_apply_receipt",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["operationId"],
    "properties": {
      "operationId": { "type": "string", "format": "uuid" }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["operationId", "outcome"],
    "properties": {
      "operationId": { "type": "string", "format": "uuid" },
      "outcome": { "type": "string", "enum": ["COMPLETED", "REJECTED"] }
    }
  },
  "outcomes": ["COMPLETED", "REJECTED"],
  "required_policy": ["payment:internal"],
  "idempotency_mode": "none",
  "idempotency_scope": "none",
  "timeout_ms": 2000,
  "enabled": false,
  "is_default": false
}
