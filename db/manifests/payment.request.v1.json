{
  "contract_version": "course-1",
  "module": "payment",
  "action": "request",
  "version": 1,
  "http_method": "POST",
  "target_schema": "app",
  "target_function": "payment_request",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["operationKind", "amount", "currency"],
    "properties": {
      "operationKind": {
        "type": "string",
        "enum": ["PAYMENT_EXECUTION", "PAYMENT_APPROVAL"]
      },
      "amount": {
        "type": "string",
        "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9]?)|[1-9][0-9]{0,15}(?:\\.[0-9]{1,2})?)$"
      },
      "currency": {
        "type": "string",
        "const": "RUB"
      }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operationId",
      "requestId",
      "operationKind",
      "amount",
      "currency",
      "status"
    ],
    "properties": {
      "operationId": { "type": "string", "format": "uuid" },
      "requestId": { "type": "string", "minLength": 1 },
      "operationKind": {
        "type": "string",
        "enum": ["PAYMENT_EXECUTION", "PAYMENT_APPROVAL"]
      },
      "amount": {
        "type": "string",
        "pattern": "^(?:0\\.(?:0[1-9]|[1-9][0-9]?)|[1-9][0-9]{0,15}(?:\\.[0-9]{1,2})?)$"
      },
      "currency": { "type": "string", "const": "RUB" },
      "status": {
        "type": "string",
        "enum": ["CREATED", "PROCESSING", "COMPLETED", "REJECTED"]
      }
    }
  },
  "outcomes": ["CREATED"],
  "required_policy": ["payment:write"],
  "idempotency_mode": "required",
  "idempotency_scope": "principal_action",
  "timeout_ms": 5000,
  "enabled": false,
  "is_default": false
}
